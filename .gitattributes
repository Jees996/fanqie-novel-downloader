# 统一换行符：仓库内一律存 LF，检出时按平台转换
* text=auto eol=lf

# Windows 批处理必须 CRLF，否则 cmd 解析可能出错
*.bat text eol=crlf
*.cmd text eol=crlf

# shell 脚本必须 LF
*.sh text eol=lf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
